# Frozen prompts are hashed byte for byte (manifest sha256): never convert their line endings.
bench/prompts/** -text

# launchers keep their platform line endings wherever the repository is cloned
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# copies of real packs' native_experts.txt, parsed byte for byte by tests/core/expert_layout_test.cpp
tests/data/native_experts/** -text

# Fixed upstream license sources are audited byte for byte on every host.
licenses/video/** -text

# Shared speech contracts carry hashes and must match on Windows and Linux.
serve/asr/contract.py text eol=lf
serve/asr/media.py text eol=lf

# The fork's landing page is maintained separately; sync_upstream configures this driver.
README.md merge=t8-keep
